{
  "name": "social-rig",
  "version": "0.1.0",
  "description": "Turn your repo into a marketing machine. AI-powered content generation grounded in real project data.",
  "type": "module",
  "bin": {
    "social-rig": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --clean",
    "dev": "tsup src/cli.ts --format esm --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "marketing",
    "social-media",
    "content-generation",
    "developer-tools",
    "cli",
    "ai"
  ],
  "author": "godilite",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.0",
    "better-sqlite3": "^11.3.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "hono": "^4.6.0",
    "inquirer": "^9.3.0",
    "nanoid": "^5.0.7",
    "open": "^10.1.0",
    "ora": "^8.1.0",
    "simple-git": "^3.27.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/inquirer": "^9.0.9",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
